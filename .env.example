# Environment Configuration for AuthShield
PROJECT_NAME=AuthShield
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=authshield-super-secret-production-grade-key-32bytes-minimum-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Default: local SQLite. For PostgreSQL: postgresql://user:password@localhost:5432/authshield
DATABASE_URL=sqlite:///./authshield.db

# Detection Engine Settings
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=300

UNAUTHORIZED_ACCESS_THRESHOLD=3
UNAUTHORIZED_ACCESS_WINDOW_SECONDS=300

# AI Provider Keys (for Threat Insights & Security Copilot with Fallback)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
